{
  "scripts": {
    "apply-config": "npx cap copy",
    "build:debug": "yarn apply-config && cd ./android && ./gradlew assembleDebug && cd ..",
    "build:release": "yarn apply-config && cd ./android && ./gradlew assembleRelease && cd ..",
    "start": "yarn apply-config && npx cap run android --livereload --external",
    "debug": "python3 -m http.server 8080 --directory src"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "0.34.5"
    }
  }
}
